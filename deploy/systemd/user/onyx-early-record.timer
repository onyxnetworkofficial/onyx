# Runs onyx-early-record.service once a day after 00:30 UTC: a UTC day is written only once the
# first block of the next day is final (Base Sepolia: about 15 to 20 minutes). A missed run (machine
# off) starts at the next boot. Install: see onyx-early-record.service.

[Unit]
Description=Onyx early-contributor record, daily after 00:30 UTC

[Timer]
OnCalendar=*-*-* 00:30:00 UTC
RandomizedDelaySec=600
Persistent=true
AccuracySec=60

[Install]
WantedBy=timers.target
