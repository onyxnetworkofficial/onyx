# The agent connector (north-star loop NL21, ROADMAP S5): apps/agent/src/http.mjs, the Onyx MCP
# server over Streamable HTTP, behind Caddy's /mcp route (deploy/caddy/onyx-web.Caddyfile).
# scripts/deploy-api.sh installs it with the toolkit in /opt/onyx-mcp when the host has Node 20
# or later. It holds no key and pays for nothing. onyx_propose_dataset is on (website meeting polish
# MP1, 2026-10-29, after the node's intake limits went live in ROADMAP S5): it checks first, records
# only on the user's confirm, 5 per client address an hour; the node's intake then takes the proposal.

[Unit]
Description=Onyx MCP agent connector (testnet)
After=network-online.target onyx-node.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/node /opt/onyx-mcp/src/http.mjs
Environment=ONYX_API_URL=http://127.0.0.1:8080
Environment=ONYX_MCP_LISTEN=127.0.0.1:8090
Environment=ONYX_MCP_TRUSTED_PROXY=127.0.0.1
Environment=ONYX_MCP_ORIGINS=https://onyx.cryptagraph.com
Environment=ONYX_MCP_ALLOW_PROPOSE=1
DynamicUser=yes
Restart=on-failure
RestartSec=5s

# Hardening (no MemoryDenyWriteExecute: Node's JIT needs writable code pages).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=169.254.0.0/16 fe80::/10
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
